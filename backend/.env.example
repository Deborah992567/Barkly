# BARKLY backend environment template.
# Copy to `backend/.env` and fill in values. Never commit the real `.env`.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# PostgreSQL session URL (async). The default below matches a local developer
# database. Adjust host/port/credentials for your machine.
DATABASE_URL=postgresql+asyncpg://barkly@127.0.0.1:5432/barkly_dev

# JWT signing secret. MUST be set (>= 32 chars) when ENVIRONMENT=production.
# Development falls back to a clearly-marked insecure dev value.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS allowed origins (comma-separated). Native iOS clients do not need CORS;
# keep origins explicit and never default to "*".
ALLOWED_ORIGINS=http://localhost:3000

# AI inference provider. Phase 2 ships only the clearly-labelled development
# placeholder. Future values: audio-behavior-model, vision-behavior-model, ...
AI_PROVIDER=development-placeholder

# Media storage. Phase 2 ships the local filesystem provider only.
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_ROOT=./media_storage
MAX_UPLOAD_SIZE_BYTES=25000000

# Pagination bounds
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Standardized disclaimer attached to behavioral results
DISCLAIMER=BARKLY provides AI-based behavioral estimates from available signals and context. Results are not guaranteed interpretations and are not veterinary diagnoses.